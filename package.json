{
  "name": "webseguimiento",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migracion": "supabase migration new",
    "db:tipos": "supabase gen types typescript --local > src/types/database.types.ts",
    "sonar:up": "docker compose -f docker/sonarqube.yml up -d sonarqube",
    "sonar:scan": "docker compose -f docker/sonarqube.yml --profile scan run --rm scanner",
    "sonar:down": "docker compose -f docker/sonarqube.yml down",
    "migrar:fotos-heic": "node scripts/convertir-fotos-heic.mjs",
    "migrar:recomprimir-fotos": "node scripts/recomprimir-fotos.mjs",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.5.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@supabase/supabase-js": "^2.110.0",
    "framer-motion": "^12.42.2",
    "heic2any": "^0.0.4",
    "maplibre-gl": "^3.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-map-gl": "^7.0.21",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "heic-convert": "^2.1.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.2",
    "vite": "^6.0.5"
  }
}
